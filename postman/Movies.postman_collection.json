  "item": [
    {
      "name": "Películas",
      "item": [
        {
          "name": "Listar películas",
          "request": {
            "method": "GET",
            "url": "http://localhost:8080/api/v1/peliculas"
          }
        },
        {
          "name": "Obtener película por ID",
          "request": {
            "method": "GET",
            "url": "http://localhost:8080/api/v1/peliculas/1"
          }
        },
        {
          "name": "Crear película - Scream",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Scream\",\n  \"anio\": 1996,\n  \"duracion\": 111,\n  \"genero\": \"terror\",\n  \"sinopsis\": \"La historia sigue a Sidney Prescott, una joven acechada por Ghostface, un asesino enmascarado que utiliza las reglas de las películas de terror para aterrorizar a su grupo de amigos en un pequeño pueblo.\",\n  \"fechaEstreno\": 1996\n}"
            },
            "url": "http://localhost:8080/api/v1/peliculas"
          }
        },
        {
          "name": "Crear película - Memento",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Memento\",\n  \"anio\": 2000,\n  \"duracion\": 113,\n  \"genero\": \"thriller\",\n  \"sinopsis\": \"Narra la historia de Leonard, un ex investigador de seguros que sufre de amnesia anterógrada tras un ataque en el que su esposa fue asesinada. Para encontrar al culpable, Leonard sobrevive usando fotografías instantáneas y tatuajes en su cuerpo que registran las pistas.\",\n  \"fechaEstreno\": 2000\n}"
            },
            "url": "http://localhost:8080/api/v1/peliculas"
          }
        },
        {
          "name": "Actualizar película",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Scream\",\n  \"anio\": 1996,\n  \"duracion\": 111,\n  \"genero\": \"terror\",\n  \"sinopsis\": \"La historia sigue a Sidney Prescott, una joven acechada por Ghostface, un asesino enmascarado que utiliza las reglas de las películas de terror para aterrorizar a su grupo de amigos en un pequeño pueblo.\",\n  \"fechaEstreno\": 1996\n}"
            },
            "url": "http://localhost:8080/api/v1/peliculas/1"
          }
        },
        {
          "name": "Eliminar película",
          "request": {
            "method": "DELETE",
            "url": "http://localhost:8080/api/v1/peliculas/1"
          }
        }
      ]
    },
