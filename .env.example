# ==============================
# Variables para Docker Compose
# Copia este archivo como .env y ajusta los valores
# ==============================

# MySQL container
MYSQL_ROOT_PASSWORD=system
MYSQL_DATABASE=db_movies
MYSQL_HOST_PORT=3307

# App container
APP_HOST_PORT=8080

# Spring Boot app (en Docker)
DB_URL_DOCKER=jdbc:mysql://mysql:3306/db_movies?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=system

# JWT (minimo 32 caracteres)
JWT_SECRET=movies-clave-secreta-jwt-2026-cambiar-en-produccion

# TMDB API
TMDB_API_KEY=f93703cc198d66c87da4d35312d35b51
TMDB_BASE_URL=https://api.themoviedb.org/3
